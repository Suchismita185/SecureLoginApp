<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔑"
            android:textSize="55sp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Forgot Password"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Enter your registered email or mobile number to receive a 6-digit recovery OTP."
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:hint="Email Address or Mobile Number">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etResetIdentifier"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:inputType="textEmailAddress" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSendResetOtp"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:text="Send Recovery OTP"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/primary_blue"
            app:cornerRadius="12dp" />

        <LinearLayout
            android:id="@+id/layoutOtpSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginTop="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enter 6-digit Reset OTP"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="17sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp">

                <EditText
                    android:id="@+id/otp1"
                    style="@style/OtpBox"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="55dp"/>

                <EditText
                    android:id="@+id/otp2"
                    style="@style/OtpBox"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="55dp"/>

                <EditText
                    android:id="@+id/otp3"
                    style="@style/OtpBox"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="55dp"/>

                <EditText
                    android:id="@+id/otp4"
                    style="@style/OtpBox"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="55dp"/>

                <EditText
                    android:id="@+id/otp5"
                    style="@style/OtpBox"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="55dp"/>

                <EditText
                    android:id="@+id/otp6"
                    style="@style/OtpBox"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="55dp"/>

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerifyResetOtp"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Verify OTP &amp; Proceed"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@color/primary_blue"
                app:cornerRadius="12dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
